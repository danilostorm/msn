# NUNCA envie .env com senhas para o GitHub.
MSN_ADMIN_PASSWORD=MUDE_PARA_UMA_SENHA_LONGA_ALEATORIA
MSN_SITE_PASSWORD=MUDE_PARA_OUTRA_SENHA
MSN_TARGET_HOST=im.hoststorm.com.br
MSN_LOGIN_HOST=msn.hoststorm.com.br
MSN_STORAGE_HOST=msn.hoststorm.com.br
# Para acesso publico futuro: 0.0.0.0 (requer firewall e DNS configurados)
MSN_LISTEN_ADDR=127.0.0.1
MSN_HTTP_PORT=18081

# Abrir somente quando HTTPS e protecao anti-abuso estiverem prontos.
MSN_PUBLIC_SIGNUP=0

# Host privado do AEROCOOL no Tailscale: somente Oracle deve acessar as portas publicadas
MSN_TAILSCALE_ADDR=100.99.136.79
